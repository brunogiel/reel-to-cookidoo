# Credenciales de tu cuenta de Cookidoo, para cookidoo-headless.js.
# Copiá este archivo a ~/.config/cookidoo/env (chmod 600) y completalo.
# Ese path queda fuera del repo. Si preferís un .env en esta carpeta, está
# en el .gitignore, pero nunca lo subas ni lo compartas.
COOKIDOO_EMAIL=
COOKIDOO_PASSWORD=

# 'international' (dominio cookidoo.international, idioma en) o
# 'es' (dominio cookidoo.es, idioma es-ES). Default: international.
COOKIDOO_DOMAIN=international
